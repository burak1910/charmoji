# Charmoji yapılandırma örneği.
# Bu dosyayı proje kökünde ".env" adıyla kopyalayın ve değerleri düzenleyin:
#   cp .env.example .env
# .env dosyası gizli bilgi içerir; git'e EKLEMEYİN.
# Gerçek ortam değişkenleri (sunucu/konteyner ayarı) .env değerlerinden önceliklidir.

# Veritabanı bağlantısı (zorunlu; DB_PASSWORD boş bırakılabilir ama satır bulunmalı)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=charmoji
DB_USER=charmoji_uygulama
DB_PASSWORD=

# PHP hatalarının yazılacağı dosya (isteğe bağlı).
# Boş bırakılırsa web sunucusunun kendi hata günlüğü kullanılır.
APP_LOG_FILE=
